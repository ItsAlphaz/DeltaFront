# /etc/deltafront/game.env  (owner root, mode 0600)
# The game container's environment (docker --env-file: no quotes, no `export`).
# Every CHANGE_ME is a placeholder; never commit the filled-in file.

GAME_ENV=prod
DOMAIN=example.com
INSTANCE_LETTER=a
NUM_WORKERS=2
# Same value the image was built with (the server checks it against the client).
DF_ACCOUNT_FEATURES=accounts,store,inventory,clans,leaderboards
# Same as the account API and the client build: uncomment only if email sign-in is on.
# DF_EMAIL_AUTH=1

# Registered with: npm run admin -- server:key:create game-1
API_KEY=CHANGE_ME
# The public site key of the Turnstile widget (the secret is the API's).
TURNSTILE_SITE_KEY=CHANGE_ME
# Signed-in players may join while the bot check is unreachable; guests may not.
TURNSTILE_FALLBACK=registered
CSP_MODE=enforce
# Do NOT set GIT_COMMIT here. The image bakes the commit it was built from
# (docker build --build-arg GIT_COMMIT=...), and a value in this file overrides
# it: the footer, the version check between clients and server and every
# archived game record would keep naming the commit of the first deploy.
