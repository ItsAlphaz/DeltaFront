# /etc/deltafront/backup.env  (owner root, group df-backup, mode 0640)
# Only a read-only database role, a PUBLIC age key and an rclone remote NAME.
# The remote's credentials are in the df-backup user's rclone config; the age
# private key is NOT on this machine (docs/Deployment.md, "Backups").

BACKUP_DATABASE_URL=postgres://df_backup:CHANGE_ME@127.0.0.1:5432/deltafront
BACKUP_DIR=/var/backups/deltafront
BACKUP_ENCRYPT=age
BACKUP_AGE_RECIPIENT=age1CHANGE_ME
BACKUP_REMOTE=b2:deltafront-backups/prod
BACKUP_KEEP_LOCAL_DAILY=7
BACKUP_KEEP_REMOTE_DAILY=14
BACKUP_KEEP_REMOTE_WEEKLY=8
BACKUP_KEEP_REMOTE_MONTHLY=12
