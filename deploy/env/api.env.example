# /etc/deltafront/api.env  (owner root, group df-api, mode 0640)
# The account API's environment. Every value below is a PLACEHOLDER: replace
# each CHANGE_ME; `npm run launch:check` fails while one is left.
# Never commit the filled-in file.

GAME_ENV=prod
DOMAIN=example.com
API_PUBLIC_ORIGIN=https://api.example.com
ALLOWED_ORIGINS=https://example.com
API_PORT=8787
# nginx is exactly one proxy in front of the API.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info

# The launch feature set. The client build and the game server use the same.
DF_ACCOUNT_FEATURES=accounts,store,inventory,clans,leaderboards

# Least-privilege role (deploy/postgresql/roles.sql). Migrations use another one.
DATABASE_URL=postgres://df_app:CHANGE_ME@127.0.0.1:5432/deltafront
DATABASE_POOL_MAX=10

# Ed25519 private key (PKCS#8 PEM), owner df-api, mode 0600, outside the repo.
JWT_PRIVATE_KEY_PATH=/etc/deltafront/jwt-ed25519.pem
# During a key rotation only (docs/Deployment.md, "Rotating the signing key"):
# JWT_PREVIOUS_PUBLIC_KEY_PATH=/etc/deltafront/jwt-previous.pub.pem

TURNSTILE_SECRET_KEY=CHANGE_ME
DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_CLIENT_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
