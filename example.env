# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# Grafana Faro collector URL for browser client telemetry (errors, web
# vitals). Leave empty to keep client telemetry off.
FARO_COLLECTOR_URL=

# Optional analytics (DeltaFront's own accounts). Leave empty to load none.
# GA4 measurement ID, e.g. G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=
# Cloudflare Web Analytics beacon token (32 hex characters)
CLOUDFLARE_ANALYTICS_TOKEN=

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32

# ---------------------------------------------------------------------------
# DeltaFront account features and the account API (src/account-api)
# See docs/DeltaFrontServices.md and docs/DeltaFrontAccountsPlan.md.
# Never commit real values: keep them in .env (ignored by git) or in the
# deployment's secret store.
# ---------------------------------------------------------------------------

# Features to switch on, comma-separated. Empty (the default) = everything off.
# Names: accounts, store, inventory, ranked, clans, leaderboards, payments,
# friends, progression, tribes, trustedLobbies. The client build, the game server and the
# account API must all see the same value (the game server refuses to start if
# its value differs from the one the client was built with).
# PUBLIC LAUNCH (GAME_ENV=staging or prod): exactly
#   DF_ACCOUNT_FEATURES=accounts,store,inventory,clans,leaderboards
# Staging and prod refuse any other feature (ranked, payments, friends,
# progression, tribes and trustedLobbies have no backend yet).
DF_ACCOUNT_FEATURES=

# Email magic-link sign-in (milestone M8). OFF unless DF_EMAIL_AUTH is 1 or true,
# and the same value for the client build (docker build --build-arg
# DF_EMAIL_AUTH=1), the game server and the account API. Needs the accounts
# feature. In dev it uses an in-memory mailer whose links are readable at
# http://localhost:8787/dev/email-outbox?email=<address> (loopback only, dev
# only); in staging and prod it needs a real provider, a sender and a key.
# DF_EMAIL_AUTH=
# EMAIL_PROVIDER=resend            # dev | resend | postmark (dev is refused outside dev)
# EMAIL_FROM=DeltaFront <login@mail.your-domain.tld>   # a domain verified with the provider (SPF, DKIM, DMARC)
# EMAIL_API_KEY=                   # the provider's API key: a secret, server side only

# Account API (npm run start:account-api). GAME_ENV (dev|staging|prod) has no
# default; DOMAIN, API_PUBLIC_ORIGIN and ALLOWED_ORIGINS are required outside dev.
# GAME_ENV=dev
API_PORT=8787
# Must be https://api.<DOMAIN> outside dev (the client checks token issuers).
API_PUBLIC_ORIGIN=
# Site origins allowed to call the API from a browser, comma-separated.
# https only outside dev; no wildcards.
ALLOWED_ORIGINS=
LOG_LEVEL=info

# PostgreSQL (required; there is no fallback database).
DATABASE_URL=postgres://user:password@localhost:5432/deltafront
DATABASE_POOL_MAX=10
# Per-statement ceiling in milliseconds (1000-300000, default 30000). Outside
# the machine hosting PostgreSQL use sslmode=verify-full in DATABASE_URL.
# DATABASE_STATEMENT_TIMEOUT_MS=30000
# How long a graceful shutdown waits for in-flight requests (default 15000).
# SHUTDOWN_TIMEOUT_MS=15000
# Only for npm run test:account-api: a server where databases can be created.
# DATABASE_URL_TEST=postgres://postgres:test@localhost:5432/postgres

# Reverse proxies in front of the API (nginx = 1); 0 trusts no forwarded header.
TRUST_PROXY_HOPS=0
# Cloudflare Turnstile secret (the server side of TURNSTILE_SITE_KEY). Required
# outside dev when the accounts feature is enabled; in dev, unset skips the check.
TURNSTILE_SECRET_KEY=
# Hostnames a Turnstile token may have been solved on, comma-separated
# (each also matches its subdomains). Default outside dev: DOMAIN.
# TURNSTILE_ALLOWED_HOSTNAMES=
# The action the client sets on the widget (default "join").
# TURNSTILE_ACTION=join
# GAME SERVER: what a first join may do when the bot check cannot be run
# (Cloudflare or the API unreachable): "registered" (default outside dev:
# signed-in players are admitted, guests are refused with an explanation), "closed"
# (nobody) or "open" (everybody; the dev default, refused by launch:check).
# TURNSTILE_FALLBACK=registered
# GAME SERVER: the public site key of the same Turnstile widget.
# TURNSTILE_SITE_KEY=
# GAME SERVER: Content-Security-Policy for the app shell: enforce (default
# outside dev), report-only, or off (refused by launch:check).
# CSP_MODE=enforce
# GAME SERVER: set to 1 ONLY for a private rehearsal of GAME_ENV=prod while
# the Terms and Privacy pages are still placeholders. Logged on every start.
# ALLOW_PLACEHOLDER_LEGAL_PAGES=

# Required outside dev when the accounts feature is enabled.
# Path to the Ed25519 private key that signs access tokens (never commit it).
JWT_PRIVATE_KEY_PATH=
# Optional: the previous public key, kept during a key rotation.
JWT_PREVIOUS_PUBLIC_KEY_PATH=
# Discord and Google OAuth apps (set both of a pair, or neither).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Backups (npm run backup:run, npm run backup:drill; docs/Deployment.md)
# Only public keys and an rclone remote NAME belong here: the remote's
# credentials live in the backup user's rclone config, the age private key
# stays off the server.
# ---------------------------------------------------------------------------
# BACKUP_DATABASE_URL=postgres://df_backup:...@127.0.0.1:5432/deltafront
# BACKUP_DIR=/var/backups/deltafront
# BACKUP_ENCRYPT=age
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_REMOTE=b2:deltafront-backups/prod
# BACKUP_KEEP_LOCAL_DAILY=7
# BACKUP_KEEP_REMOTE_DAILY=14
# BACKUP_KEEP_REMOTE_WEEKLY=8
# BACKUP_KEEP_REMOTE_MONTHLY=12
