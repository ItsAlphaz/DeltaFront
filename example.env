# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# Grafana Faro collector URL for browser client telemetry (errors, web
# vitals). Leave empty to keep client telemetry off.
FARO_COLLECTOR_URL=

# Optional analytics (DeltaFront's own accounts). Leave empty to load none.
# GA4 measurement ID, e.g. G-XXXXXXXXXX
GOOGLE_ANALYTICS_ID=
# Cloudflare Web Analytics beacon token (32 hex characters)
CLOUDFLARE_ANALYTICS_TOKEN=

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32

# ---------------------------------------------------------------------------
# DeltaFront account features and the account API (src/account-api)
# See docs/DeltaFrontServices.md and docs/DeltaFrontAccountsPlan.md.
# Never commit real values: keep them in .env (ignored by git) or in the
# deployment's secret store.
# ---------------------------------------------------------------------------

# Features to switch on, comma-separated. Empty (the default) = everything off.
# Names: accounts, store, ranked, clans, leaderboards, payments, friends,
# progression, tribes, trustedLobbies. The client build, the game server and the
# account API must all see the same value.
DF_ACCOUNT_FEATURES=

# Account API (npm run start:account-api). GAME_ENV (dev|staging|prod) has no
# default; DOMAIN, API_PUBLIC_ORIGIN and ALLOWED_ORIGINS are required outside dev.
# GAME_ENV=dev
API_PORT=8787
# Must be https://api.<DOMAIN> outside dev (the client checks token issuers).
API_PUBLIC_ORIGIN=
# Site origins allowed to call the API from a browser, comma-separated.
# https only outside dev; no wildcards.
ALLOWED_ORIGINS=
LOG_LEVEL=info

# PostgreSQL (required; there is no fallback database).
DATABASE_URL=postgres://user:password@localhost:5432/deltafront
DATABASE_POOL_MAX=10
# Only for npm run test:account-api: a server where databases can be created.
# DATABASE_URL_TEST=postgres://postgres:test@localhost:5432/postgres

# Reverse proxies in front of the API (nginx = 1); 0 trusts no forwarded header.
TRUST_PROXY_HOPS=0
# Cloudflare Turnstile secret (the server side of TURNSTILE_SITE_KEY). Required
# outside dev when the accounts feature is enabled; in dev, unset skips the check.
TURNSTILE_SECRET_KEY=

# Required outside dev when the accounts feature is enabled.
# Path to the Ed25519 private key that signs access tokens (never commit it).
JWT_PRIVATE_KEY_PATH=
# Optional: the previous public key, kept during a key rotation.
JWT_PREVIOUS_PUBLIC_KEY_PATH=
# Discord and Google OAuth apps (set both of a pair, or neither).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
